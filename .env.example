# Main Anthropic Messages-compatible vLLM endpoint.
VLLM_BASE_URL=http://host.docker.internal:8000
# Optional authoritative upstream model id. Blank preserves the client request model.
VLLM_BASE_MODEL=
# Base response delivery policy: auto detects SSE vs JSON; use buffered for coarse/non-token-streaming backends.
VLLM_BASE_RESPONSE_MODE=auto
VLLM_BASE_API_KEY=

# Base Native Vision passthrough is opt-in. Both flags must be true.
# direct_image/read_image can bypass Proxy Vision; PDF/read_pdf_image remain on the Proxy Vision pipeline.
VLLM_BASE_VISION_ENABLED=false
VISION_NATIVE_PASSTHROUGH=false
VLLM_BASE_CONNECT_TIMEOUT_MS=10000
VLLM_BASE_HEADERS_TIMEOUT_MS=900000
VLLM_BASE_BODY_TIMEOUT_MS=900000

# Optional Claude Code Context Compact worker. URL + MODEL enable the external compact route.
# Ollama uses native /api/chat + think; vLLM uses /v1/chat/completions + chat_template_kwargs.enable_thinking.
CONTEXT_COMPACT_PROVIDER=ollama
CONTEXT_COMPACT_URL=http://host.docker.internal:11434
CONTEXT_COMPACT_MODEL=qwen3.6:27b-q4_K_M-cc
CONTEXT_COMPACT_API_KEY=
CONTEXT_COMPACT_THINK=false

# Optional multimodal endpoint. Provider selects vLLM OpenAI-compatible or Ollama native API.
# URL and MODEL must be configured together to analyze images and scanned PDFs.
VLLM_VISION_URL=http://host.docker.internal:8001
VLLM_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VLLM_VISION_API_KEY=
VLLM_VISION_PROVIDER=vllm
VLLM_VISION_THINK=false
VLLM_VISION_TIMEOUT_MS=120000

# Optional managed network tools.
SEARXNG_URL=http://host.docker.internal:8088
WEB_FETCH_URL=http://host.docker.internal:8090
WEB_FETCH_API_KEY=

# Prompt-directed WebFetch Processor. Provider: vllm or ollama. Base URLs auto-expand to /v1/chat/completions.
WEB_FETCH_PROCESSOR_ENABLED=true
WEB_FETCH_PROCESSOR_PROVIDER=vllm
WEB_FETCH_PROCESSOR_URL=
WEB_FETCH_PROCESSOR_MODEL=
WEB_FETCH_PROCESSOR_API_KEY=
WEB_FETCH_PROCESSOR_THINK=false
WEB_FETCH_PROCESSOR_CONCURRENCY=3
WEB_FETCH_PROCESSOR_TIMEOUT_MS=300000

# Optional dedicated Final Language Processor. This is independent from WebFetch Processor.
# Ollama uses native /api/chat + think; vLLM uses /v1/chat/completions + chat_template_kwargs.enable_thinking.
LANG_PROCESSOR_ENABLED=false
LANG_PROCESSOR_PROVIDER=vllm
LANG_PROCESSOR_URL=
LANG_PROCESSOR_MODEL=
LANG_PROCESSOR_API_KEY=
LANG_PROCESSOR_THINK=false

# Final presentation language for user-visible model answers and Proxy progress/status text.
# Supported: zh-TW, zh-CN, en-US, ja-JP, ko-KP. Missing/blank/unsupported values fall back to en-US.
MODEL_RESPONSE_LANGUAGE=en-US

# Simple operational settings.
RESOURCE_PROFILE=default
# Auxiliary Vision calls keep a bounded local semaphore; Base/Managed requests are never Proxy-queued.
VISION_MAX_CONCURRENCY=
LOG_LEVEL=info
LOG_PROTOCOL_SNIPPETS=false
PROXY_PORT=8080

# Managed task safety for slower local models.
MANAGED_MODEL_ROUND_TIMEOUT_MS=360000
# Streaming inactivity deadline; 0 disables it. Buffered mode ignores this and keeps the round deadline absolute.
MANAGED_MODEL_STALL_TIMEOUT_MS=90000

# Managed SSE progress and slow-upstream protection.
PROGRESS_VISIBLE_AFTER_MS=1500
PROGRESS_PING_INTERVAL_MS=5000
PROGRESS_HEARTBEAT_MS=30000
SSE_DRAIN_TIMEOUT_MS=10000

# Persistent normalized media cache. 0 disables proxy capacity eviction and uses filesystem capacity.
MEDIA_CACHE_MAX_MB=0

# Optional Claude Code built-in WebSearch/WebFetch protocol diagnostic. Disabled for normal V0.2.23 operation.
# Enable only while collecting a diagnostic trace. Search and Fetch quotas are independent.
DIAGNOSTIC_WEB_TOOL_PASSTHROUGH=false
DIAGNOSTIC_WEB_SEARCH_PASSTHROUGH_COUNT=1
DIAGNOSTIC_WEB_FETCH_PASSTHROUGH_COUNT=1
DIAGNOSTIC_WEB_TOOL_TRACE=false
DIAGNOSTIC_WEB_TOOL_TRACE_DIR=/var/lib/vllm-cc-tools-proxy/diagnostics/web-tool-trace
